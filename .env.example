# Optional: omit DATABASE_URL to use the persistent embedded PostgreSQL database.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/zhongxue
# Set a real key and a supported model to enable live AI.
AI_API_KEY=
# Example 1: AgentRouter with DeepSeek V4 Flash
# AI_MODEL=deepseek-v4-flash
# AI_BASE_URL=https://agentrouter.org/v1
# Example 2: OpenRouter
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_MS=90000
# App-wide AI attempts per UTC day (independent from the provider quota).
AI_DAILY_LIMIT=50
# Enable only behind your own proxy that replaces forwarded headers.
TRUST_PROXY=false
# APP_ORIGIN=https://your-domain.example
# Optional private local database folder. Each process needs its own folder.
# ZHONGXUE_DATA_DIR=C:/Users/you/zhongxue_db
