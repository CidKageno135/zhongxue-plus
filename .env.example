# =====================================================================
# ZhongXue New V2 — Biến Môi Trường Mẫu (.env.example)
# =====================================================================
# Lưu ý quan trọng về An toàn Bảo mật:
# - KHÔNG BAO GIỜ commit tệp .env chứa API key thật vào Git repository.
# - Máy chủ hoạt động theo cơ chế Server-Key Mode: Toàn bộ khóa nhạy cảm
#   được lưu trữ và bảo vệ nghiêm ngặt ở phía máy chủ (Node.js backend),
#   tuyệt đối KHÔNG chuyển tiếp xuống bundle trình duyệt (Client-side).
# - Mọi yêu cầu client có baseUrl tùy ý (ngoài allowlist) sẽ KHÔNG ĐƯỢC
#   sử dụng các khóa máy chủ bên dưới.
# =====================================================================

# 1. Cấu hình Máy chủ Production (Node.js Standalone Server)
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:5173

# 2. Cấu hình Đường dẫn Tĩnh & Dữ liệu
# Mặc định tự động nhận diện nếu để trống
DIST_PATH=dist
DICT_PATH=data/dictionary/CVDICT.u8.gz

# 3. Cấu hình Nhà cung cấp Upstream AI (AgentRouter / OpenRouter)
AI_BASE_URL=https://agentrouter.org/v1
AI_MODEL=gpt-6.1-sol
AI_TIMEOUT_MS=12000
AI_DAILY_LIMIT=1000

# 4. Khóa Xác thực Máy chủ (Server-Key Mode — Giữ bí mật)
# Dedicated Key dành riêng cho mô hình GPT-6.1 Sol (OpenAI Responses API)
AI_SOL_KEY=your_sol_key_here

# Khóa mô hình DeepSeek qua AgentRouter; KHÔNG dùng cho api.deepseek.com
AI_DEEPSEEK_KEY=your_deepseek_key_here

# Khóa riêng cho DeepSeek trực tiếp (tùy chọn)
AI_DEEPSEEK_DIRECT_KEY=
# Khóa riêng cho OpenRouter (tùy chọn)
AI_OPENROUTER_KEY=

# Khóa tổng quát chỉ thuộc origin AI_BASE_URL đã xác thực; không chuyển sang origin khác
AI_API_KEY=your_agentrouter_api_key_here
