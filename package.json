{
  "name": "zhongxue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader runner && npm run build:server",
    "build:server": "vite build --ssr server/index.ts --outDir dist/server --configLoader runner",
    "start": "node dist/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --configLoader runner",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "test:security": "vitest run --configLoader runner tests/security-policy.test.ts tests/integration/api-security.test.ts",
    "test:integration": "vitest run --configLoader runner tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
